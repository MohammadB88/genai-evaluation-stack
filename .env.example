# Copy to .env and adjust. Nothing loads this file automatically — export it
# explicitly (see README quickstart) or set the variables in your shell/CI.

# --- Endpoints (localhost placeholders — replace with real URLs later) ---
MODEL_ENDPOINT=http://localhost:8000/v1
MODEL_NAME=my-app-model
JUDGE_ENDPOINT=http://localhost:8001/v1
JUDGE_MODEL=my-judge-model
# EMBED_ENDPOINT=http://localhost:8002/v1   # not used in Phase 1
API_KEY=not-needed

# --- Eval runner defaults ---
DATASET=datasets/golden_qa_de.jsonl
METRICS=answer_relevancy,correctness
OUT=results/eval_results.json

# --- MLflow (optional; runs are logged only when the URI is set) ---
# MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=genai-eval

# --- Telemetry muzzles (air-gap defaults; see docs in design doc §D) ---
DEEPEVAL_TELEMETRY_OPT_OUT=1
DEEPEVAL_NO_INSPECT_PROMPT=1
DEEPEVAL_DISABLE_DOTENV=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
# RAGAS_DO_NOT_TRACK=true          # only relevant if Ragas is adopted (Phase 3)
# PHOENIX_TELEMETRY_ENABLED=false  # only relevant if Phoenix is ever used
